include README.md

# Include the Cython sources
recursive-include src/charis *.pyx

# The calibration data is tracked in git but downloaded from Zenodo at run time, and
# setuptools_scm would otherwise put the whole tree into the sdist.
prune calibrations

# Not needed to build or use the package, and most of the sdist's size: example notebooks
# with outputs and the old Sphinx documentation, including its built HTML.
prune notebooks
prune documentation
prune .github
exclude autodoc.sh
