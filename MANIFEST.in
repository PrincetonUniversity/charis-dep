include README.md

# Include the Cython sources
recursive-include src/charis *.pyx

# Include calibration data files
recursive-include src/charis/calibrations *.fits
recursive-include src/charis/calibrations *.json
recursive-include src/charis/calibrations *.dat

# Include any deeper nested calibration data
recursive-include src/charis/calibrations **/*.fits
recursive-include src/charis/calibrations **/*.json
recursive-include src/charis/calibrations **/*.dat
